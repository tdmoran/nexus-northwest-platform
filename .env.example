# --- Database ---
DATABASE_URL="postgresql://nexus:nexus@localhost:5432/nexus?schema=public"

# --- NextAuth ---
NEXTAUTH_SECRET="change-me-please-use-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# --- Optional SSO. Leave empty to disable a provider. Both link to existing
# OrganiserUser records by email; sign-in is denied if an organiser hasn't
# been pre-invited (invite-only). ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID="common"

# --- Public site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Nexus Northwest"

# --- Token signing for tokenized links (RSVP, preferences, unsubscribe) ---
TOKEN_SECRET="change-me-32-bytes-min-please"

# --- Cron / scheduler bearer token (header: Authorization: Bearer <CRON_SECRET>) ---
CRON_SECRET="change-me-please-cron-bearer-token"

# --- Optional Redis (for distributed rate limiting). Falls back to in-memory if unset. ---
REDIS_URL=""

# --- Email (stub: writes to disk under .mail/ unless provider is set) ---
EMAIL_FROM="hello@nexusnorthwest.example"
EMAIL_PROVIDER="stub"          # stub | sendgrid | resend
EMAIL_API_KEY=""

# --- Email webhook bearer token (fallback when no provider signature is configured) ---
EMAIL_WEBHOOK_SECRET="change-me-please-webhook-secret"

# --- SendGrid Ed25519 verification (paste the public key from SendGrid console) ---
SENDGRID_WEBHOOK_PUBLIC_KEY=""

# --- Resend / Svix signing secret (whsec_...) ---
RESEND_WEBHOOK_SECRET=""

# --- Zoho CRM (stubbed unless ZOHO_ENABLED=true) ---
ZOHO_ENABLED="false"
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
ZOHO_REFRESH_TOKEN=""
ZOHO_API_DOMAIN="https://www.zohoapis.eu"
ZOHO_MODULE="Leads"            # Leads | Contacts | <CustomModule>

# --- WhatsApp group join links (used in welcome email) ---
WHATSAPP_BROADCAST_GROUP_URL="https://chat.whatsapp.com/CM72dFAFlgCHc9NHh50jlV"
WHATSAPP_DISCUSSION_GROUP_URL="https://chat.whatsapp.com/FyxGLUTKbq2BOifsAGaAEc"

# --- WhatsApp Business Cloud API (Phase 2). Disabled by default. ---
WHATSAPP_ENABLED="false"
WHATSAPP_PHONE_NUMBER_ID=""              # numeric Meta phone-number id
WHATSAPP_ACCESS_TOKEN=""                 # system-user access token
WHATSAPP_VERIFY_TOKEN="change-me-please" # used during webhook subscription
WHATSAPP_TEMPLATE_NAME="event_announcement"
WHATSAPP_TEMPLATE_LANGUAGE="en"
WHATSAPP_GRAPH_VERSION="v20.0"
