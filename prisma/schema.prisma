// Nexus Northwest Platform - Prisma schema
// Postgres-backed local mirror; Zoho CRM remains source of truth for member records
// when ZOHO_ENABLED=true. See src/lib/zoho.ts for the integration boundary.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // DIRECT_URL is optional. When set (e.g. Neon's unpooled connection), Prisma
  // routes migrations + introspection through it while runtime queries continue
  // to use the pooled URL.
  directUrl = env("DIRECT_URL")
}

// ----------------------------- Auth / Organisers ----------------------------

enum OrganiserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  VIEWER
}

model OrganiserUser {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String
  passwordHash  String
  role          OrganiserRole  @default(VIEWER)
  active        Boolean        @default(true)
  mfaEnrolled   Boolean        @default(false)
  mfaSecret     String?        // base32-encoded TOTP secret; null until enrolled
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  lastLoginAt   DateTime?

  events        Event[]        @relation("EventCreator")
  series        EventSeries[]  @relation("SeriesCreator")
  surveys       EventSurvey[]  @relation("SurveyCreator")
  announcements Announcement[] @relation("AnnouncementSender")
  actionsOwned  ActionItem[]   @relation("ActionOwner")
  audit         AuditLog[]
  managedMembers Member[]      @relation("MemberAddedBy")
  magicLinks    MagicLink[]
}

// One-time login link for organisers. Single-use, short TTL (15 min).
model MagicLink {
  id              String        @id @default(cuid())
  token           String        @unique
  organiserUserId String
  organiserUser   OrganiserUser @relation(fields: [organiserUserId], references: [id], onDelete: Cascade)
  expiresAt       DateTime
  consumedAt      DateTime?
  requestedFromIp String?
  createdAt       DateTime      @default(now())

  @@index([organiserUserId])
}

// ----------------------------- Members --------------------------------------

enum CommunicationChannel {
  EMAIL
  WHATSAPP
  BOTH
  OTHER
}

model Member {
  id                  String   @id @default(cuid())
  // Zoho id is null until first sync; email is the dedupe key
  zohoId              String?  @unique
  email               String   @unique
  name                String
  company             String?
  phone               String?
  whatsappNumber      String?
  signalHandle        String?
  linkedinUrl         String?
  profilePictureUrl   String?
  preferredChannel    CommunicationChannel @default(EMAIL)
  emailConsent        Boolean  @default(true)
  emailConsentAt      DateTime?
  whatsappConsent     Boolean  @default(false)
  whatsappConsentAt   DateTime?
  emailOptOutAt       DateTime?
  whatsappOptOutAt    DateTime?
  emailBouncedAt      DateTime?
  utmSource           String?
  utmMedium           String?
  utmCampaign         String?
  utmContent          String?
  referralCode        String?  // referral CODE THIS MEMBER WAS RECRUITED VIA (inbound)
  inviteSlug          String?  @unique  // shareable code OUTBOUND (members can invite friends)
  speakerProspect     Boolean  @default(false)
  notes               String?
  tags                String[] @default([])
  // Member-managed directory entry. Only listed publicly when publicProfile=true.
  publicProfile       Boolean  @default(false)
  headline            String?
  bio                 String?
  addedById           String?
  // GDPR: soft-delete with grace window. deletedAt is set when the grace
  // period expires and a hard-delete worker scrubs PII on the next pass.
  deletionRequestedAt DateTime?
  deletedAt           DateTime?
  addedBy             OrganiserUser? @relation("MemberAddedBy", fields: [addedById], references: [id])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  rsvps               RSVP[]
  tokens              Token[]
  audit               AuditLog[]
  zohoFailures        ZohoSyncFailure[]
  whatsappMessages    WhatsAppMessage[]
  surveyResponses     EventSurveyResponse[]

  @@index([createdAt])
  @@index([utmSource])
}

// ----------------------------- Events ---------------------------------------

model Event {
  id              String   @id @default(cuid())
  title           String
  description     String
  startsAt        DateTime
  endsAt          DateTime?
  timezone        String   @default("Europe/Dublin")
  location        String
  onlineUrl       String?
  heroImageUrl    String?
  capacity        Int?
  rsvpEnabled     Boolean  @default(true)
  reminderOffsets Int[]    @default([10080, 1440, 120])  // minutes before start: 7d, 24h, 2h
  reminderAudience String  @default("all")               // "all" | "rsvp_yes"
  tags            String[] @default([])
  seriesId        String?
  series          EventSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  createdById     String
  createdBy       OrganiserUser @relation("EventCreator", fields: [createdById], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  rsvps           RSVP[]
  announcements   Announcement[]
  actions         ActionItem[]
  reminders       Reminder[]
  survey          EventSurvey?

  @@index([startsAt])
  @@index([seriesId])
}

// A recurring event template that materialises new Event rows on a cadence.
enum SeriesCadence {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

model EventSeries {
  id              String        @id @default(cuid())
  title           String
  description     String
  cadence         SeriesCadence
  startTimeLocal  String        // "HH:MM"
  durationMinutes Int           @default(120)
  timezone        String        @default("Europe/Dublin")
  location        String
  onlineUrl       String?
  heroImageUrl    String?
  capacity        Int?
  reminderOffsets Int[]         @default([10080, 1440, 120])
  reminderAudience String       @default("all")
  tags            String[]      @default([])
  active          Boolean       @default(true)
  startsOn        DateTime
  lookaheadCount  Int           @default(2)
  createdById     String
  createdBy       OrganiserUser @relation("SeriesCreator", fields: [createdById], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  events          Event[]
}

// ----------------------------- Surveys -------------------------------------
//
// One survey per event (1:1). Questions are stored as a small JSON schema —
// each entry has `id`, `prompt`, and `kind` ∈ { rating | text | choice }.
// Responses store a parallel JSON map keyed by question id.

model EventSurvey {
  id          String        @id @default(cuid())
  eventId     String        @unique
  event       Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  questions   Json          // [{ id, prompt, kind, choices? }]
  active      Boolean       @default(true)
  dispatchedAt DateTime?    // populated when the post-event email blast fires
  createdById String
  createdBy   OrganiserUser @relation("SurveyCreator", fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  responses   EventSurveyResponse[]
}

model EventSurveyResponse {
  id        String      @id @default(cuid())
  surveyId  String
  survey    EventSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  answers   Json        // { [questionId]: string | number }
  submittedAt DateTime  @default(now())

  @@unique([surveyId, memberId])
  @@index([surveyId])
}

enum RSVPStatus {
  YES
  NO
  MAYBE
  CANCELLED
  WAITLISTED
}

model RSVP {
  id              String     @id @default(cuid())
  eventId         String
  memberId        String
  status          RSVPStatus
  channel         String?     // how the RSVP came in: email/whatsapp/web/etc
  attendedAt      DateTime?   // populated at check-in
  noShow          Boolean    @default(false)  // organiser flag for didn't-show
  waitlistedAt    DateTime?   // set when status=WAITLISTED so order is deterministic
  promotedAt      DateTime?   // set when promoted from WAITLISTED → YES
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  event           Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member          Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([eventId, memberId])
  @@index([status])
  @@index([eventId, status, waitlistedAt])
}

// ----------------------------- Announcements --------------------------------

enum Channel {
  EMAIL
  WHATSAPP
}

enum AnnouncementStatus {
  DRAFT
  SCHEDULED
  QUEUED
  SENT
  FAILED
  CANCELLED
}

model Announcement {
  id           String   @id @default(cuid())
  eventId      String?
  event        Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  channel      Channel
  subject      String?
  body         String
  audienceTag  String?            // freeform: "all", "rsvp_yes", "tag:speakers"
  status       AnnouncementStatus @default(DRAFT)
  scheduledFor DateTime?          // populated when status=SCHEDULED
  sentAt       DateTime?
  sentById     String?
  sentBy       OrganiserUser?     @relation("AnnouncementSender", fields: [sentById], references: [id])
  recipientCount Int               @default(0)
  meta         Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, scheduledFor])
}

// ----------------------------- Actions --------------------------------------

enum ActionType {
  TASK
  SPEAKER_PROSPECT
  CONTRIBUTOR_PROSPECT
  THEME
}

enum ActionStatus {
  NEW
  CONTACTED
  CONFIRMED
  SCHEDULED
  COMPLETED
  CANCELLED
}

model ActionItem {
  id          String   @id @default(cuid())
  type        ActionType   @default(TASK)
  title       String
  notes       String?
  status      ActionStatus @default(NEW)
  dueAt       DateTime?
  ownerId     String?
  owner       OrganiserUser? @relation("ActionOwner", fields: [ownerId], references: [id])
  eventId     String?
  event       Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([dueAt])
}

// ----------------------------- Tokens (RSVP / Preferences / Unsubscribe) ----

enum TokenPurpose {
  RSVP
  PREFERENCES
  UNSUBSCRIBE
  SURVEY_RESPONSE
}

model Token {
  id          String   @id @default(cuid())
  token       String   @unique
  purpose     TokenPurpose
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  eventId     String?  // populated for RSVP tokens
  expiresAt   DateTime?
  consumedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([memberId, purpose])
}

// ----------------------------- Zoho sync failures --------------------------
//
// Persists each upsert that didn't reach Zoho so the dashboard can surface a
// banner and an organiser can retry. Cleared automatically when a later upsert
// of the same member succeeds.

model ZohoSyncFailure {
  id          String   @id @default(cuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  attempts    Int      @default(1)
  lastError   String
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([memberId])
  @@index([resolvedAt])
}

// ----------------------------- WhatsApp messages ---------------------------
//
// Logs every WhatsApp Business Cloud API send and delivery receipt. Keyed by
// the provider's wamid for idempotency on inbound webhook events.

enum WhatsAppMessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

model WhatsAppMessage {
  id           String                @id @default(cuid())
  memberId     String
  member       Member                @relation(fields: [memberId], references: [id], onDelete: Cascade)
  toPhone      String
  templateName String?
  variables    Json?
  providerId   String?               @unique         // wamid from Meta
  status       WhatsAppMessageStatus @default(QUEUED)
  errorCode    String?
  errorMessage String?
  sentAt       DateTime?
  deliveredAt  DateTime?
  readAt       DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([memberId])
  @@index([status])
}

// ----------------------------- Reminders -----------------------------------
//
// Reminder records are written when a reminder fires for a given (event, offset)
// pair so re-runs of the cron dispatcher are idempotent. A second per-recipient
// row is written for individual sends — see ReminderSend.

model Reminder {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  offsetMinutes Int
  audience    String   // "all" or "rsvp_yes"
  sentAt      DateTime @default(now())
  recipientCount Int   @default(0)
  meta        Json?

  @@unique([eventId, offsetMinutes])
}

// ----------------------------- Audit ----------------------------------------

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actor       OrganiserUser? @relation(fields: [actorId], references: [id])
  memberId    String?
  member      Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  action      String   // e.g. "member.signup", "announcement.send", "rbac.role.change"
  channel     String?
  meta        Json?
  createdAt   DateTime @default(now())

  @@index([action, createdAt])
}
